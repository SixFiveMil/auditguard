# Researcher Identity & Compliance Configuration
# Copy this file to config/researcher.env and fill in your authorized details.

RESEARCHER_NAME="Joshua (Security Professional)"
RESEARCHER_HANDLE="joshua_sec"
RESEARCHER_EMAIL="joshua_sec@we-are-hackers.com"
RESEARCHER_PLATFORM="HackerOne"

# Security Safe-Harbor Tag inserted into outbound HTTP headers
# e.g., X-Bug-Bounty: joshua_sec (HackerOne Researcher)
HEADER_IDENTIFIER="joshua_sec (HackerOne Researcher; contact: joshua_sec@we-are-hackers.com)"

# Strict Human-in-the-Loop requirement:
# When set to true, NO request will ever fire without interactive terminal approval
REQUIRE_INTERACTIVE_APPROVAL=true

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=10.0

# Path to append-only audit log
AUDIT_LOG_PATH="audit/audit_log.jsonl"
